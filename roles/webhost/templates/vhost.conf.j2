# Managed by ansible - roles/webhost/templates/vhost.conf.j2
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ item.name }}.local;

    # mkcert leaf cert (scripts/issue-cert.sh). Plain HTTP stays available on
    # purpose - no redirect - for devices that haven't trusted the CA yet.
    ssl_certificate /etc/ssl/webhost/webhost.pem;
    ssl_certificate_key /etc/ssl/webhost/webhost-key.pem;

    include snippets/lan-only.conf;

    client_max_body_size 110M;

    location / {
        proxy_pass http://127.0.0.1:{{ item.port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
